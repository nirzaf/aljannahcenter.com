---
import { getMenu, getSiteSettings } from "emdash";
import {
  EmDashBodyEnd,
  EmDashBodyStart,
  EmDashHead,
  WidgetArea,
} from "emdash/ui";
import LiveSearch from "emdash/ui/search";
import { createPublicPageContext } from "emdash/page";
import { Check, ChevronDown, HandHeart, Languages, Mail, MapPin, Menu, Phone, Search, X } from "lucide-react";
import BrandIcon from "../components/BrandIcon.astro";
import { centre } from "../data/centre";
import { defaultLang, getLang, languages, localePath, stripLang, useTranslations } from "../i18n";
import type { Lang } from "../i18n";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
}

type NavItem = {
  label: string;
  url: string;
  target?: string;
};

const {
  title,
  description,
  image,
  canonical,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  content,
} = Astro.props;

const lang = getLang(Astro);
const t = useTranslations(lang);
const link = (path: string) => localePath(lang, path);
const isDefaultLang = lang === defaultLang;

let siteTitle = t("site.name");
let siteTagline = t("site.tagline");
let primaryItems: NavItem[] = [
  { label: t("nav.about"), url: link("/pages/about") },
  { label: t("nav.programmes"), url: link("/#programmes") },
  { label: t("nav.impact"), url: link("/#impact") },
  { label: t("nav.stories"), url: link("/updates") },
  { label: t("nav.gallery"), url: link("/gallery") },
  { label: t("nav.contact"), url: link("/#contact") },
];
let socialItems: NavItem[] = [
  { label: "Facebook", url: "https://www.facebook.com/aljannahcentre/", target: "_blank" },
  { label: "Instagram", url: "https://www.instagram.com/aljannahcentre/", target: "_blank" },
];

try {
  // CMS settings and menus are written in English; other languages use the translated defaults.
  if (isDefaultLang) {
    const settings = await getSiteSettings();
    siteTitle = settings.title || siteTitle;
    siteTagline = settings.tagline || siteTagline;
  }
} catch {
  // The public shell remains useful while a new D1 database is being initialized.
}

try {
  const menu = isDefaultLang ? await getMenu("primary") : null;
  if (menu?.items?.length) {
    const items = menu.items as NavItem[];
    // Upgrade the original seeded navigation without replacing custom CMS menus.
    const legacyRoutes = ["/", "/pages/about", "/updates", "/#gallery", "/#support"];
    const isLegacySeed = items.length === legacyRoutes.length &&
      items.every((item, index) => item.url === legacyRoutes[index]);
    if (!isLegacySeed) primaryItems = items;
  }
} catch {
  // Fall back to the local navigation until the seed is applied.
}

try {
  const menu = await getMenu("social");
  if (menu?.items?.length) socialItems = menu.items as NavItem[];
} catch {
  // The fallback social links are the Centre's known official channels.
}

// Keep the retired channel out of existing CMS menus as well as local links.
socialItems = socialItems.filter((item) => {
  try {
    const hostname = new URL(item.url).hostname.toLowerCase();
    return !(hostname === "youtu.be" || hostname === "youtube.com" || hostname.endsWith(".youtube.com"));
  } catch {
    return item.label.toLowerCase() !== "youtube";
  }
});

const currentPath = stripLang(Astro.url.pathname);
const fullTitle = title === siteTitle || title.includes(siteTitle)
  ? title
  : title + " | " + siteTitle;
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.url).toString();
const pageContext = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: type,
  title: fullTitle,
  pageTitle: title,
  description: description ?? siteTagline,
  canonical: resolvedCanonical,
  image,
  content,
  seo: { ogImage: image },
  articleMeta: { publishedTime, modifiedTime, author },
  siteName: siteTitle,
});
const isLoggedIn = Boolean(Astro.locals.user);
const year = new Date().getFullYear();

// The same page in every language, for the switcher and search engines.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code].label,
  glyph: languages[code].glyph,
  href: localePath(code, currentPath + Astro.url.search),
}));
const fontHref: Partial<Record<Lang, string>> = {
  ta: "https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400..800&family=Noto+Serif+Tamil:wght@400..600&display=swap",
  si: "https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@400..800&family=Noto+Serif+Sinhala:wght@400..600&display=swap",
  ar: "https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400..700&family=Noto+Sans+Arabic:wght@400..800&display=swap",
};

// First visit only: visitors whose device is set to Tamil, Sinhala or Arabic are taken
// to that version. English stays the default for everyone else, and a language picked
// from the menu is remembered and always wins.
const autoLangTargets =
  isDefaultLang && !currentPath.startsWith("/admin")
    ? Object.fromEntries(alternates.filter((item) => item.code !== defaultLang).map((item) => [item.code, item.href]))
    : null;

function isActive(url: string) {
  url = stripLang(url);
  const path = url.split("#")[0];
  if (url.includes("#")) return false;
  return path === "/" ? currentPath === "/" : currentPath === path || currentPath.startsWith(path + "/");
}
---

<!doctype html>
<html lang={lang} dir={languages[lang].dir}>
  <head>
    <meta charset="UTF-8" />
    {autoLangTargets && (
      <script is:inline define:vars={{ autoLangTargets }}>
        try {
          if (!localStorage.getItem("ajc-lang")) {
            var deviceLang = (navigator.language || "").toLowerCase().split("-")[0];
            if (autoLangTargets[deviceLang]) location.replace(autoLangTargets[deviceLang] + location.hash);
          }
        } catch (error) {
          // Storage can be blocked; the page simply stays in English.
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#20266e" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Nunito+Sans:opsz,wght@6..12,400..800&display=swap"
    />
    {fontHref[lang] && <link rel="stylesheet" href={fontHref[lang]} />}
    {alternates.map((item) => (
      <link rel="alternate" hreflang={item.code} href={new URL(item.href, Astro.url).toString()} />
    ))}
    <EmDashHead page={pageContext} />
  </head>
  <body>
    <EmDashBodyStart page={pageContext} />
    <a class="skip-link" href="#main-content">{t("common.skip")}</a>

    <div class="utility-strip">
      <div class="utility-strip-inner">
        <p><MapPin size={14} aria-hidden="true" /> {t("site.location")}</p>
        <div class="utility-strip-links">
          <a href={centre.phone.href}><Phone size={14} aria-hidden="true" /> {centre.phone.label}</a>
          <a href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer"><BrandIcon name="whatsapp" size={14} /> WhatsApp</a>
        </div>
      </div>
    </div>

    <header class="site-header" data-site-header>
      <div class="site-header-inner">
        <a class="brand" href={link("/")} aria-label={t("nav.homeLabel")}>
          <picture class="brand-image">
            <source media="(min-width: 640px)" srcset="/ajc-wordmark.webp" width="1200" height="184" />
            <img class="brand-logo" src="/ajc-crest.webp" alt="Al-Jannah Centre" width="256" height="272" />
          </picture>
        </a>

        <nav class="primary-nav" aria-label={t("nav.primary")}>
          {primaryItems.map((item) => (
            <a
              href={item.url}
              target={item.target}
              rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
              aria-current={isActive(item.url) ? "page" : undefined}
            >{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <div class="header-search" data-header-search>
            <button
              class="search-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="header-search-pop"
              data-search-toggle
            >
              <Search size={20} aria-hidden="true" />
              <span class="sr-only">{t("common.search")}</span>
            </button>
            <div
              class="search-pop"
              id="header-search-pop"
              data-search-pop
              style={`--search-loading: "${t("search.loading")}"; --search-empty: "${t("search.noResults")}";`}
              hidden
            >
              <LiveSearch
                placeholder={t("common.searchPlaceholder")}
                inputClass="header-search-input"
                resultsClass="header-search-results"
                resultClass="header-search-result"
                collections={["posts", "pages"]}
                searchPage={link("/search")}
                routeMap={{ posts: link("/posts/:path"), pages: link("/pages/:path") }}
              />
            </div>
          </div>
          <details class="lang-menu" data-lang-menu>
            <summary aria-label={t("site.language") + ": " + languages[lang].label}>
              <Languages size={19} aria-hidden="true" />
              <span class="lang-menu-current" aria-hidden="true">{languages[lang].label}</span>
              <ChevronDown size={15} className="lang-menu-caret" aria-hidden="true" />
            </summary>
            <ul class="lang-menu-list">
              {alternates.map((item) => (
                <li>
                  <a href={item.href} lang={item.code} hreflang={item.code} aria-current={item.code === lang ? "true" : undefined}>
                    <span class="lang-glyph" aria-hidden="true">{item.glyph}</span>
                    <span>{item.label}</span>
                    {item.code === lang && <Check size={16} className="lang-menu-check" aria-hidden="true" />}
                  </a>
                </li>
              ))}
            </ul>
          </details>
          {isLoggedIn && <a class="header-admin" href="/admin">{t("common.staffDesk")}</a>}
          <a class="button button-gold header-donate" href={link("/#support")}>
            <HandHeart size={18} aria-hidden="true" /> <span>{t("common.supportUs")}</span>
          </a>
          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-menu-toggle
          >
            <Menu size={22} className="menu-icon-open" aria-hidden="true" />
            <X size={22} className="menu-icon-close" aria-hidden="true" />
            <span class="sr-only">{t("common.menu")}</span>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
        <nav class="lang-switch lang-switch-menu" aria-label={t("site.language")}>
          {alternates.map((item) => (
            <a href={item.href} lang={item.code} hreflang={item.code} aria-current={item.code === lang ? "true" : undefined}>
              <span class="lang-glyph" aria-hidden="true">{item.glyph}</span> {item.label}
            </a>
          ))}
        </nav>
        <nav class="mobile-menu-links" aria-label={t("nav.mobile")}>
          {primaryItems.map((item) => (
            <a href={item.url} aria-current={isActive(item.url) ? "page" : undefined}>{item.label}</a>
          ))}
          {isLoggedIn && <a href="/admin">{t("common.staffDesk")}</a>}
        </nav>
        <form class="mobile-search" method="get" action={link("/search")} role="search">
          <label class="sr-only" for="mobile-search-input">{t("common.searchPlaceholder")}</label>
          <Search size={18} aria-hidden="true" />
          <input id="mobile-search-input" type="search" name="q" placeholder={t("common.searchPlaceholder")} />
        </form>
        <div class="mobile-menu-contact">
          <a href={centre.phone.href}><Phone size={18} aria-hidden="true" /> {centre.phone.label}</a>
          <a href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer"><BrandIcon name="whatsapp" size={18} /> WhatsApp</a>
        </div>
        <div class="mobile-menu-social">
          {socialItems.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.label}><BrandIcon name={item.label} /></a>
          ))}
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand brand-light" href={link("/")} aria-label={t("nav.homeLabel")}>
            <img class="footer-logo" src="/ajc-wordmark.webp" alt="Al-Jannah Centre" width="1200" height="184" loading="lazy" />
          </a>
          <p>{siteTagline} {t("footer.blurb", { year: centre.since })}</p>
          <div class="footer-social">
            {socialItems.map((item) => (
              <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.label}><BrandIcon name={item.label} /></a>
            ))}
          </div>
        </div>
        <div>
          <h2 class="footer-title">{t("footer.explore")}</h2>
          <ul class="footer-links">
            {primaryItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
            <li><a href={link("/posts")}>{t("footer.archive")}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-title">{t("footer.contact")}</h2>
          <ul class="footer-links footer-contact">
            <li><a href={centre.phone.href}><Phone size={16} aria-hidden="true" /> {centre.phone.label}</a></li>
            <li><a href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer"><BrandIcon name="whatsapp" size={16} /> {centre.whatsapp.label}</a></li>
            <li><a href={centre.email.href}><Mail size={16} aria-hidden="true" /> <span class="break">{centre.email.label}</span></a></li>
            <li><a href={centre.address.mapHref} target="_blank" rel="noopener noreferrer"><MapPin size={16} aria-hidden="true" /> {centre.address.lines.join(", ")}</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© {year} {siteTitle}. {t("footer.motto")}</p>
        <nav class="lang-switch lang-switch-footer" aria-label={t("site.language")}>
          {alternates.map((item) => (
            <a href={item.href} lang={item.code} hreflang={item.code} aria-current={item.code === lang ? "true" : undefined}>
              <span class="lang-glyph" aria-hidden="true">{item.glyph}</span> {item.label}
            </a>
          ))}
        </nav>
        <div>
          <a href="/rss.xml">RSS</a>
          <a href="/admin">{t("footer.staffSignIn")}</a>
        </div>
      </div>
      <div class="footer-widget"><WidgetArea name="footer" /></div>
    </footer>

    <nav class="action-bar" aria-label={t("common.quickActions")}>
      <a href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer"><BrandIcon name="whatsapp" /><span>WhatsApp</span></a>
      <a class="action-bar-primary" href={link("/#support")}><HandHeart size={20} aria-hidden="true" /><span>{t("common.supportUs")}</span></a>
    </nav>

    <EmDashBodyEnd page={pageContext} />

    <script>
      // Progressive enhancement flag for the section-reveal styles.
      document.documentElement.classList.add("js");

      const header = document.querySelector<HTMLElement>("[data-site-header]");
      const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

      function setMenu(open: boolean) {
        if (!toggle || !menu) return;
        toggle.setAttribute("aria-expanded", String(open));
        menu.hidden = !open;
        document.documentElement.classList.toggle("menu-open", open);
        document.querySelector<HTMLElement>("main")?.toggleAttribute("inert", open);
        document.querySelector<HTMLElement>("footer")?.toggleAttribute("inert", open);
        document.querySelector<HTMLElement>(".action-bar")?.toggleAttribute("inert", open);
        if (open) menu.querySelector<HTMLAnchorElement>(".mobile-menu-links a")?.focus();
      }

      toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
      menu?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) setMenu(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Tab" && toggle?.getAttribute("aria-expanded") === "true" && menu) {
          const controls = [toggle, ...menu.querySelectorAll<HTMLElement>('a[href], input, button')];
          const first = controls[0];
          const last = controls[controls.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
        if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
          setMenu(false);
          toggle.focus();
        }
      });
      window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
        if (event.matches) setMenu(false);
      });

      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Header search popover.
      const searchWrap = document.querySelector<HTMLElement>("[data-header-search]");
      const searchToggle = document.querySelector<HTMLButtonElement>("[data-search-toggle]");
      const searchPop = document.querySelector<HTMLElement>("[data-search-pop]");

      function setSearch(open: boolean) {
        if (!searchToggle || !searchPop) return;
        searchToggle.setAttribute("aria-expanded", String(open));
        searchPop.hidden = !open;
        if (open) searchPop.querySelector("input")?.focus();
      }

      searchToggle?.addEventListener("click", () => setSearch(searchPop?.hidden !== false));
      document.addEventListener("click", (event) => {
        if (searchWrap && !searchWrap.contains(event.target as Node) && searchPop && !searchPop.hidden) {
          setSearch(false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && searchPop && !searchPop.hidden) {
          setSearch(false);
          searchToggle?.focus();
        }
      });

      // Remember a language chosen by hand so the device-language redirect never overrides it.
      document.addEventListener("click", (event) => {
        const choice = (event.target as HTMLElement).closest<HTMLAnchorElement>(".lang-menu a[hreflang], .lang-switch a[hreflang]");
        if (!choice) return;
        try {
          localStorage.setItem("ajc-lang", choice.hreflang);
        } catch {
          // Storage can be blocked; the choice then applies to this visit only.
        }
      });

      // Language menu: close when clicking elsewhere or pressing Escape.
      const langMenu = document.querySelector<HTMLDetailsElement>("[data-lang-menu]");
      document.addEventListener("click", (event) => {
        if (langMenu?.open && !langMenu.contains(event.target as Node)) langMenu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && langMenu?.open) {
          langMenu.open = false;
          langMenu.querySelector("summary")?.focus();
        }
      });

      // Gentle section reveal on scroll.
      const revealEls = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      }

      // Copy buttons, used for bank account details.
      document.addEventListener("click", async (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
        if (!button) return;
        const value = button.dataset.copy ?? "";
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const field = document.createElement("textarea");
          field.value = value;
          document.body.appendChild(field);
          field.select();
          const copied = document.execCommand("copy");
          field.remove();
          if (!copied) {
            const label = button.querySelector("[data-copy-label]");
            if (label) label.textContent = button.dataset.copyRetry ?? "Try again";
            return;
          }
        }
        const label = button.querySelector("[data-copy-label]");
        const original = label?.textContent;
        button.classList.add("is-copied");
        if (label) label.textContent = button.dataset.copyDone ?? "Copied";
        window.setTimeout(() => {
          button.classList.remove("is-copied");
          if (label && original) label.textContent = original;
        }, 1800);
      });
    </script>
  </body>
</html>
