---
import { Image, PortableText } from "emdash/ui";
import { ArrowLeft, HandHeart, Phone } from "lucide-react";
import Base from "../layouts/Base.astro";
import BrandIcon from "../components/BrandIcon.astro";
import PostCard from "../components/PostCard.astro";
import { formatDate, getLang, localePath, useTranslations } from "../i18n";
import { getLocalizedCollection } from "../i18n/content";
import { getReadingTime } from "../utils/reading-time";

interface Props {
  post: any;
  slug: string;
}

// Shared by /posts/[slug] and the language routes, which load the entry first.
const { post, slug } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const link = (path: string) => localePath(lang, path);

const publishedTime = post.data.publishedAt?.toISOString() ?? null;
const author = (post.data.bylines ?? [])
  .map((credit: any) => credit.byline.displayName)
  .join(", ") || null;
const readingTime = getReadingTime(post.data.content);

// Share links (simple outbound links — no third-party embeds).
const shareUrl = new URL(Astro.url.pathname, Astro.url).toString();
const facebookShareHref =
  "https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent(shareUrl);
const whatsappShareHref =
  "https://wa.me/?text=" + encodeURIComponent(post.data.title + " " + shareUrl);

let related: any[] = [];
try {
  const result = await getLocalizedCollection("posts", { orderBy: { published_at: "desc" }, limit: 4 }, lang);
  related = result.entries.filter((entry: any) => entry.id !== post.id).slice(0, 3);
  if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
} catch {
  // Related stories are optional; the article renders without them.
}
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={post.data.updatedAt?.toISOString() ?? null}
  author={author}
  content={{ collection: "posts", id: post.data.id, slug }}
>
  <article class="container article">
    <a class="back-link" href={link("/updates")}><ArrowLeft size={16} aria-hidden="true" /> {t("post.back")}</a>
    <header class="article-header">
      <p class="kicker">{t("post.kicker")}</p>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        {post.data.publishedAt && (
          <time datetime={publishedTime ?? undefined}>{formatDate(post.data.publishedAt, lang, "long")}</time>
        )}
        {author && <><span class="meta-dot" /><span>{author}</span></>}
        <span class="meta-dot" /><span>{t("common.minRead", { n: readingTime })}</span>
      </div>
      {post.data.excerpt && <p class="article-excerpt">{post.data.excerpt}</p>}
    </header>

    {post.data.featured_image && (
      <div class="article-image"><Image image={post.data.featured_image} /></div>
    )}

    <div class="article-layout">
      <div class="article-main">
        <div class="prose">
          <PortableText value={post.data.content ?? []} />
        </div>
        <div class="share-row">
          <span>{t("post.share")}</span>
          <a href={facebookShareHref} target="_blank" rel="noopener noreferrer">
            <BrandIcon name="facebook" size={16} /> Facebook
          </a>
          <a href={whatsappShareHref} target="_blank" rel="noopener noreferrer">
            <BrandIcon name="whatsapp" size={16} /> WhatsApp
          </a>
        </div>
      </div>
      <aside class="article-aside" aria-label={t("post.getInvolved")}>
        <p>{t("post.inspired")}</p>
        <a class="button button-gold" href={link("/#support")}><HandHeart size={17} aria-hidden="true" /> {t("post.support")}</a>
        <a class="button button-outline" href={link("/#contact")}><Phone size={16} aria-hidden="true" /> {t("post.contact")}</a>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">{t("post.more")}</h2>
        <div class="post-grid">
          {related.map((entry: any) => (
            <PostCard
              title={entry.data.title}
              excerpt={entry.data.excerpt}
              content={entry.data.content}
              featuredImage={entry.data.featured_image}
              href={link("/posts/" + entry.id)}
              date={entry.data.publishedAt}
              bylines={entry.data.bylines}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Base>
