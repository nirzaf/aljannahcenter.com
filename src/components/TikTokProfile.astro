---
import { ArrowUpRight } from "lucide-react";
import BrandIcon from "./BrandIcon.astro";
import { socialProfiles } from "../data/centre";
import { officialSocialPosts } from "../data/social-posts";
import { parseSocialUrl } from "../utils/social-embed";
import { getLang, useTranslations } from "../i18n";

interface Props {
  /** Heading level; the homepage uses it as a section title. */
  heading?: "h2" | "h3";
  /** List every official channel instead of the single TikTok link. */
  showProfiles?: boolean;
}

const { heading: Heading = "h3", showProfiles = false } = Astro.props;
const t = useTranslations(getLang(Astro));

// Two recent TikTok videos in TikTok's own player. (TikTok's profile widget is
// rate-limited on some networks and then renders an error box.) The newest video
// is skipped because the social feed beside this block already leads with it.
const videos = officialSocialPosts
  .map((url) => parseSocialUrl(url))
  .filter((embed) => embed?.platform === "tiktok")
  .slice(1, 3);
---

<div class="tiktok-profile">
  <div class="tiktok-profile-copy">
    <p class="kicker">{showProfiles ? t("follow.kicker") : t("follow.kickerTikTok")}</p>
    <Heading class="tiktok-title" id="tiktok-title">{t("follow.title")}</Heading>
    <p>{t("follow.text")}</p>
    {showProfiles ? (
      <ul class="tiktok-profile-links">
        {socialProfiles.map((profile) => (
          <li>
            <a href={profile.href} target="_blank" rel="noopener noreferrer">
              <BrandIcon name={profile.platform} size={17} /> {profile.platform}
              <ArrowUpRight size={15} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <a class="text-link" href="https://www.tiktok.com/@aljannah.centre" target="_blank" rel="noopener noreferrer">
        {t("follow.visit")} <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    )}
  </div>
  <div class="tiktok-profile-videos">
    {videos.map((video, index) => (
      <div class="social-frame social-frame-portrait">
        <iframe
          src={video!.src}
          title={t("feed.frameTitle", { platform: "TikTok" }) + " " + (index + 1)}
          loading="lazy"
          allow="encrypted-media; fullscreen; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    ))}
  </div>
</div>

<style>
  .tiktok-profile { display: grid; gap: 2rem; align-items: center; }
  .tiktok-profile-copy { max-width: 30rem; }
  .tiktok-profile-copy > p:not(.kicker) { margin: 0 0 1.5rem; color: var(--muted); font-size: 1.02rem; }

  .tiktok-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.5vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -.02em;
    line-height: 1.1;
  }

  .tiktok-profile-links { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }

  .tiktok-profile-links a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.75rem;
    padding: .55rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--card);
    color: var(--ink);
    font-size: .9rem;
    font-weight: 800;
    transition: border-color .18s, color .18s, transform .18s;
  }

  .tiktok-profile-links a:hover { border-color: var(--royal); color: var(--royal); transform: translateY(-1px); }
  .tiktok-profile-links a > :global(svg:last-child) { color: #8a98bf; }

  .tiktok-profile-videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }

  .tiktok-profile-videos .social-frame { overflow: hidden; border-radius: var(--radius-lg); background: var(--ink); }

  @media (min-width: 900px) {
    .tiktok-profile { grid-template-columns: .8fr 1.2fr; gap: 4rem; }
  }
</style>
