---
import { ArrowUpRight } from "lucide-react";
import BrandIcon from "./BrandIcon.astro";
import { socialProfiles } from "../data/centre";
import { getLang, useTranslations } from "../i18n";

interface Props {
  /** Heading level; the homepage uses it as a section title. */
  heading?: "h2" | "h3";
  /** List every official channel instead of the single TikTok link. */
  showProfiles?: boolean;
}

const { heading: Heading = "h3", showProfiles = false } = Astro.props;
const t = useTranslations(getLang(Astro));
---

<div class="tiktok-profile">
  <div class="tiktok-profile-copy">
    <p class="kicker">{showProfiles ? t("follow.kicker") : t("follow.kickerTikTok")}</p>
    <Heading class="tiktok-title" id="tiktok-title">{t("follow.title")}</Heading>
    <p>{t("follow.text")}</p>
    {showProfiles ? (
      <ul class="tiktok-profile-links">
        {socialProfiles.map((profile) => (
          <li>
            <a href={profile.href} target="_blank" rel="noopener noreferrer">
              <BrandIcon name={profile.platform} size={17} /> {profile.platform}
              <ArrowUpRight size={15} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <a class="text-link" href="https://www.tiktok.com/@aljannah.centre" target="_blank" rel="noopener noreferrer">
        {t("follow.visit")} <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    )}
  </div>
  <div class="tiktok-profile-embed" data-tiktok-profile>
    <blockquote class="tiktok-embed" cite="https://www.tiktok.com/@aljannah.centre" data-unique-id="aljannah.centre" data-embed-type="creator" data-embed-from="oembed" style="max-width: 720px; min-width: 288px;">
      <section><a target="_blank" rel="noopener noreferrer" href="https://www.tiktok.com/@aljannah.centre?refer=creator_embed">{t("follow.onTikTok")}</a></section>
    </blockquote>
  </div>
</div>

<script>
  const profiles = document.querySelectorAll<HTMLElement>("[data-tiktok-profile]");
  const loadEmbed = () => {
    if (document.querySelector('script[src="https://www.tiktok.com/embed.js"]')) return;
    const script = document.createElement("script");
    script.src = "https://www.tiktok.com/embed.js";
    script.async = true;
    document.body.appendChild(script);
  };
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        loadEmbed();
        observer.disconnect();
      }
    }, { rootMargin: "200px" });
    profiles.forEach((profile) => observer.observe(profile));
  } else loadEmbed();
</script>

<style>
  .tiktok-profile { display: grid; gap: 2rem; align-items: center; }
  .tiktok-profile-copy { max-width: 30rem; }
  .tiktok-profile-copy > p:not(.kicker) { margin: 0 0 1.5rem; color: var(--muted); font-size: 1.02rem; }

  .tiktok-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.5vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -.02em;
    line-height: 1.1;
  }

  .tiktok-profile-links { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }

  .tiktok-profile-links a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.75rem;
    padding: .55rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--card);
    color: var(--ink);
    font-size: .9rem;
    font-weight: 800;
    transition: border-color .18s, color .18s, transform .18s;
  }

  .tiktok-profile-links a:hover { border-color: var(--royal); color: var(--royal); transform: translateY(-1px); }
  .tiktok-profile-links a > :global(svg:last-child) { color: #8a98bf; }

  /* A framed slot, so the section still reads as finished before the embed loads. */
  .tiktok-profile-embed {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 16rem;
    overflow: hidden;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  /* TikTok's player brings its own frame. */
  .tiktok-profile-embed:has(iframe) { padding: 0; border: 0; background: transparent; }

  .tiktok-embed { width: 100%; margin: 0 auto; border-radius: var(--radius-md); }
  .tiktok-embed a { color: var(--royal); font-weight: 800; text-decoration: underline; text-underline-offset: .2em; }

  @media (min-width: 900px) {
    .tiktok-profile { grid-template-columns: .8fr 1.2fr; gap: 4rem; }
  }
</style>
