---
import { ArrowUpRight } from "lucide-react";
import BrandIcon from "./BrandIcon.astro";
import { socialProfiles } from "../data/centre";
import TikTokProfile from "./TikTokProfile.astro";

const highlights = [
  {
    platform: "Facebook",
    label: "Latest public highlight",
    title: "Rooted in compassion, growing in excellence.",
    description: "The 8th-anniversary celebration brings together the children, families and supporters who make the Centre special.",
    image: "/social/facebook-anniversary-2026.jpg",
    alt: "Al-Jannah Centre 8th anniversary celebration graphic with children and families",
    href: "https://www.facebook.com/aljannahcentre/",
    source: "Official Facebook page",
    width: 960,
    height: 440,
    fit: "cover",
  },
  {
    platform: "Instagram",
    label: "From the feed",
    title: "La Madrassah Al Jannah",
    description: "Featuring Dali Misha Touré and the Centre’s message that Al-Jannah is more than a madrassah: it is a place of life.",
    image: "/social/instagram-madrassah-dali-misha.jpg",
    alt: "La Madrassah Al Jannah graphic from the official Al-Jannah Centre Instagram post",
    href: "https://www.instagram.com/p/CyTK17koyoX/",
    source: "Official Instagram post",
    width: 640,
    height: 640,
    fit: "contain",
  },
  {
    platform: "YouTube",
    label: "Official channel",
    title: "Subscribe for future video updates",
    description: "The official channel is ready for programme videos and announcements as the Centre shares them.",
    image: "/social/youtube-channel-artwork.jpg",
    alt: "Official Al-Jannah Centre YouTube channel artwork",
    href: "https://www.youtube.com/@al-jannahcentre5619",
    source: "Official YouTube channel",
    width: 160,
    height: 160,
    fit: "contain",
  },
];
---

<section class="section section-tint" id="follow" aria-labelledby="social-highlights-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="kicker">Stay connected</p>
        <h2 id="social-highlights-title">Follow along with the Centre</h2>
      </div>
      <p>Daily moments, announcements and celebrations are shared first on the Centre’s official channels.</p>
    </div>

    <ul class="profile-row">
      {socialProfiles.map((profile) => (
        <li>
          <a class={"profile-chip profile-" + profile.platform.toLowerCase()} href={profile.href} target="_blank" rel="noreferrer">
            <span class="profile-chip-icon"><BrandIcon name={profile.platform} /></span>
            <span class="profile-chip-text"><small>{profile.platform}</small><strong>{profile.handle}</strong></span>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>

    <div class="highlight-grid scroll-row">
      {highlights.map((highlight) => (
        <article class="highlight-card">
          <a class={"highlight-media fit-" + highlight.fit} href={highlight.href} target="_blank" rel="noreferrer" tabindex="-1" aria-hidden="true">
            <img src={highlight.image} alt={highlight.alt} width={highlight.width} height={highlight.height} loading="lazy" decoding="async" />
            <span class="highlight-badge"><BrandIcon name={highlight.platform} size={14} /> {highlight.platform}</span>
          </a>
          <div class="highlight-copy">
            <p class="card-label">{highlight.label}</p>
            <h3>{highlight.title}</h3>
            <p>{highlight.description}</p>
            <a class="text-link" href={highlight.href} target="_blank" rel="noreferrer">{highlight.source} <ArrowUpRight size={16} aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </div>
    <TikTokProfile />
  </div>
</section>
