---
import { ArrowUpRight } from "lucide-react";
import BrandIcon from "./BrandIcon.astro";
import { getLang, useTranslations } from "../i18n";

interface Props {
  isLoggedIn?: boolean;
}

const { isLoggedIn = false } = Astro.props;
const t = useTranslations(getLang(Astro));
---

<div class="empty-state">
  <img src="/ajc-crest.webp" alt="" width="256" height="272" loading="lazy" />
  <h2>{t("updates.emptyTitle")}</h2>
  {isLoggedIn ? (
    <p>Publish a daily note or weekly roundup in EmDash and it will appear here automatically.</p>
  ) : (
    <p>{t("updates.emptyText")}</p>
  )}
  <div class="empty-state-actions">
    {isLoggedIn ? (
      <a class="button button-primary" href="/_emdash/admin">Open the publishing panel</a>
    ) : (
      <>
        <a class="button button-primary" href="https://www.facebook.com/aljannahcentre/" target="_blank" rel="noreferrer"><BrandIcon name="facebook" size={18} /> {t("updates.facebook")}</a>
        <a class="button button-outline" href="https://www.instagram.com/aljannahcentre/" target="_blank" rel="noreferrer"><BrandIcon name="instagram" size={18} /> Instagram <ArrowUpRight size={16} aria-hidden="true" /></a>
      </>
    )}
  </div>
</div>
