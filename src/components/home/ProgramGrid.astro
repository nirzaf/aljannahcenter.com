---
import { ArrowRight, BookOpen, HeartHandshake, Palette, Sparkles } from "lucide-react";
import BrandIcon from "../BrandIcon.astro";
import SectionHeading from "../SectionHeading.astro";
import { centre } from "../../data/centre";
import { getLang, localePath, useTranslations } from "../../i18n";

const lang = getLang(Astro);
const t = useTranslations(lang);

const focusAreas = [
  { icon: BookOpen, title: t("programmes.education.title"), text: t("programmes.education.text") },
  { icon: HeartHandshake, title: t("programmes.therapy.title"), text: t("programmes.therapy.text") },
  { icon: Palette, title: t("programmes.vocational.title"), text: t("programmes.vocational.text") },
  { icon: Sparkles, title: t("programmes.faith.title"), text: t("programmes.faith.text") },
];
---

<section class="section" id="programmes" aria-labelledby="programmes-title">
  <div class="container" data-reveal>
    <SectionHeading
      kicker={t("programmes.kicker")}
      titleId="programmes-title"
      title={t("programmes.title")}
      description={t("programmes.description")}
    />
    <ul class="program-grid">
      {focusAreas.map(({ icon: Icon, title, text }) => (
        <li class="program-card">
          <span class="program-icon"><Icon size={22} aria-hidden="true" /></span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
    <div class="program-footer">
      <p>{t("programmes.enquiries")}</p>
      <div class="program-footer-links">
        <a class="button button-outline" href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer">
          <BrandIcon name="whatsapp" size={18} /> {t("programmes.askWhatsapp")}
        </a>
        <a class="text-link" href={localePath(lang, "/pages/about")}>
          {t("programmes.aboutCentre")} <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
