---
import { ArrowRight, BookOpen, HeartHandshake, Palette, Sparkles } from "lucide-react";
import BrandIcon from "../BrandIcon.astro";
import SectionHeading from "../SectionHeading.astro";
import { centre } from "../../data/centre";

const focusAreas = [
  {
    icon: BookOpen,
    title: "Education",
    text: "Learning that meets each child where they are, building confidence one step at a time.",
  },
  {
    icon: HeartHandshake,
    title: "Therapy",
    text: "Support that helps children grow in communication, movement and independence.",
  },
  {
    icon: Palette,
    title: "Vocational skills",
    text: "Art, craft and practical skills that turn talents into pride and possibility.",
  },
  {
    icon: Sparkles,
    title: "Faith & values",
    text: "Celebrating every child’s abilities, faith and values together with their families.",
  },
];
---

<section class="section" id="programmes" aria-labelledby="programmes-title">
  <div class="container" data-reveal>
    <SectionHeading
      kicker="What we do"
      titleId="programmes-title"
      title="Celebrating abilities, talents, faiths and values."
      description="The Centre’s work spans education, therapy and vocational training for children with special needs."
    />
    <ul class="program-grid">
      {focusAreas.map(({ icon: Icon, title, text }) => (
        <li class="program-card">
          <span class="program-icon"><Icon size={22} aria-hidden="true" /></span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
    <div class="program-footer">
      <p>For programme, admission and visit enquiries, please speak with the Centre directly.</p>
      <div class="program-footer-links">
        <a class="button button-outline" href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer">
          <BrandIcon name="whatsapp" size={18} /> Ask on WhatsApp
        </a>
        <a class="text-link" href="/pages/about">
          About the Centre <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
