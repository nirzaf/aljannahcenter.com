---
import { Mail, MapPin, Phone } from "lucide-react";
import BrandIcon from "../BrandIcon.astro";
import { centre } from "../../data/centre";
import { getLang, useTranslations } from "../../i18n";

const t = useTranslations(getLang(Astro));
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-inner">
    <div class="contact-copy" data-reveal>
      <p class="kicker">{t("contact.kicker")}</p>
      <h2 id="contact-title">{t("contact.title")}</h2>
      <p>{t("contact.text")}</p>
      <div class="contact-list">
        <a href={centre.phone.href}><span class="contact-icon"><Phone size={20} aria-hidden="true" /></span><span><small>{t("contact.call")}</small><strong>{centre.phone.label}</strong></span></a>
        <a href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer"><span class="contact-icon contact-icon-wa"><BrandIcon name="whatsapp" /></span><span><small>WhatsApp</small><strong>{centre.whatsapp.label}</strong></span></a>
        <a href={centre.email.href}><span class="contact-icon"><Mail size={20} aria-hidden="true" /></span><span><small>{t("contact.email")}</small><strong class="break">{centre.email.label}</strong></span></a>
        <a href={centre.address.mapHref} target="_blank" rel="noopener noreferrer"><span class="contact-icon"><MapPin size={20} aria-hidden="true" /></span><span><small>{t("contact.visit")}</small><strong>{centre.address.lines.join(", ")}</strong></span></a>
      </div>
    </div>
    <div class="map-card">
      <iframe
        title={t("contact.mapTitle")}
        src={centre.address.embedSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
