---
import { ArrowRight } from "lucide-react";
import { getLang, localePath, useTranslations } from "../../i18n";
import { getLocalizedCollection } from "../../i18n/content";

const lang = getLang(Astro);
const t = useTranslations(lang);

// Seeded in the Impact milestones collection; fallbacks keep a new site usable.
let impactStats = [
  { value: "2018", label: t("impact.stat.opened") },
  { value: "4", label: t("impact.stat.scholarship") },
  { value: t("impact.stat.exhibitionValue"), label: t("impact.stat.exhibition") },
];
try {
  const result = await getLocalizedCollection("impact", { orderBy: { position: "asc" }, limit: 6 }, lang);
  const published = result.entries
    .filter((entry) => typeof entry.data.value === "string" && typeof entry.data.label === "string")
    .map((entry) => ({ value: entry.data.value as string, label: entry.data.label as string }));
  // Untranslated milestones stay on the translated defaults rather than switching to English.
  if (published.length && result.translated) impactStats = published;
  if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
} catch {
  // The CMS collection is optional until the updated seed is applied.
}
---

<section class="section story" id="impact" aria-labelledby="impact-title">
  <div class="container story-inner">
    <figure class="story-photo">
      <img
        src="/hero/artists.webp"
        alt={t("impact.photoAlt")}
        width="800"
        height="800"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="story-copy" data-reveal>
      <p class="kicker">{t("impact.kicker")}</p>
      <h2 id="impact-title">{t("impact.title")}</h2>
      <p>{t("impact.text")}</p>
      <dl class="impact-stats">
        {impactStats.map((item) => (
          <div class="impact-stat">
            <dt>{item.value}</dt>
            <dd>{item.label}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={localePath(lang, "/pages/about")}>
        {t("impact.link")} <ArrowRight size={17} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
