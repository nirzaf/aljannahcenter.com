---
import type { ContentBylineCredit, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import { getReadingTime } from "../utils/reading-time";
import { formatDate, getLang, useTranslations } from "../i18n";

interface Props {
  title: string;
  excerpt?: string | null;
  content?: unknown;
  featuredImage?: MediaValue | string | null;
  href: string;
  date?: Date | null;
  bylines?: ContentBylineCredit[];
}

const { title, excerpt, content, featuredImage, href, date, bylines = [] } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const formattedDate = date ? formatDate(date, lang) : null;
const readingTime = getReadingTime(content);
---

<article class="post-card">
  <a href={href} class="post-card-link">
    {featuredImage ? (
      <div class="post-card-image"><Image image={featuredImage} /></div>
    ) : (
      <div class="post-card-placeholder" aria-hidden="true">
        <img src="/ajc-crest.webp" alt="" width="256" height="272" loading="lazy" />
      </div>
    )}
    <div class="post-card-body">
      <div class="post-meta">
        {formattedDate && <time datetime={date?.toISOString()}>{formattedDate}</time>}
        {bylines.length > 0 && <><span class="meta-dot" /><span>{bylines[0].byline.displayName}</span></>}
        <span class="meta-dot" /><span>{t("common.minRead", { n: readingTime })}</span>
      </div>
      <h3>{title}</h3>
      {excerpt && <p>{excerpt}</p>}
    </div>
  </a>
</article>
