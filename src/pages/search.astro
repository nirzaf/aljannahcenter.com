---
import { search } from "emdash";
import { Search } from "lucide-react";
import Base from "../layouts/Base.astro";
import { getLang, localePath, useTranslations } from "../i18n";

export const prerender = false;
const lang = getLang(Astro);
const t = useTranslations(lang);
const link = (path: string) => localePath(lang, path);
const query = Astro.url.searchParams.get("q")?.trim() || "";
let results: any[] = [];

if (query) {
  try {
    const response = await search(query, { collections: ["posts", "pages"], limit: 30 });
    results = response.items;
  } catch {
    results = [];
  }
}
---

<Base
  title={query ? t("common.search") + ": " + query : t("common.search")}
  description={t("search.metaDescription")}
>
  <header class="page-hero">
    <div class="container">
      <p class="kicker">{t("search.kicker")}</p>
      <h1>{t("common.search")}</h1>
      <form method="get" action={link("/search")} class="search-form" role="search">
        <label class="sr-only" for="site-search">{t("common.searchPlaceholder")}</label>
        <div>
          <input id="site-search" type="search" name="q" value={query} placeholder={t("search.try")} />
          <button class="button button-primary" type="submit"><Search size={17} aria-hidden="true" /> {t("common.search")}</button>
        </div>
      </form>
    </div>
  </header>

  <div class="container page-body">
    {query && (
      <p class="search-summary" aria-live="polite">
        {results.length === 0 ? t("search.none", { q: query }) : results.length === 1 ? t("search.one", { q: query }) : t("search.many", { n: results.length, q: query })}
      </p>
    )}

    {results.length > 0 ? (
      <ol class="search-results">
        {results.map((result) => (
          <li>
            <a href={link("/" + (result.collection === "pages" ? "pages/" : "posts/") + (result.slug ?? result.id))}>
              <span class="search-result-type">{result.collection === "pages" ? t("search.page") : t("search.article")}</span>
              <h2>{result.title ?? t("search.untitled")}</h2>
              {result.snippet && <p set:html={result.snippet} />}
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="search-summary">{query ? t("search.hintRetry") : t("search.hintEmpty")}</p>
    )}
  </div>
</Base>
