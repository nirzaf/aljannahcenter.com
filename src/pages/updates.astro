---
import { ArrowRight, CalendarDays, PenLine } from "lucide-react";
import Base from "../layouts/Base.astro";
import EmptyUpdates from "../components/EmptyUpdates.astro";
import PostCard from "../components/PostCard.astro";
import SocialFeed from "../components/SocialFeed.astro";
import SocialHighlights from "../components/SocialHighlights.astro";
import { getLang, localePath, useTranslations } from "../i18n";
import { getLocalizedCollection } from "../i18n/content";

const lang = getLang(Astro);
const t = useTranslations(lang);
const link = (path: string) => localePath(lang, path);

let posts: any[] = [];
let cacheHint: unknown;
try {
  const result = await getLocalizedCollection("posts", { orderBy: { published_at: "desc" }, limit: 100 }, lang);
  posts = result.entries;
  cacheHint = result.cacheHint;
} catch {
  // The public updates page remains useful while the CMS database is initialized.
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
const isLoggedIn = Boolean(Astro.locals.user);
---

<Base
  title={t("updates.metaTitle")}
  description={t("updates.metaDescription")}
>
  <header class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t("nav.breadcrumb")}>
        <a href={link("/")}>{t("nav.home")}</a>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{t("nav.stories")}</span>
      </nav>
      <p class="kicker">{t("updates.kicker")}</p>
      <h1>{t("updates.title")}</h1>
      <p>{t("updates.text")}</p>
      <div class="page-hero-actions">
        {isLoggedIn && <a class="button button-primary" href="/admin"><PenLine size={17} aria-hidden="true" /> Publish an update</a>}
        <a class="text-link" href={link("/posts")}>{t("updates.archiveLink")} <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </header>

  <div class="container page-body">
    {isLoggedIn && (
      <section class="staff-panel" aria-labelledby="publishing-plan-title">
        <div>
          <h2 id="publishing-plan-title">A simple publishing rhythm</h2>
          <p>Only signed-in staff see this panel. Publish from EmDash whenever there is a meaningful moment to share.</p>
        </div>
        <div class="staff-panel-cadence">
          <article>
            <CalendarDays size={19} aria-hidden="true" />
            <div><h3>Daily notes</h3><p>Short classroom moments, reminders, celebrations or thank-yous.</p></div>
          </article>
          <article>
            <CalendarDays size={19} aria-hidden="true" />
            <div><h3>Weekly roundups</h3><p>A fuller recap of progress, activities, events and ways to support.</p></div>
          </article>
        </div>
      </section>
    )}

    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            content={post.data.content}
            featuredImage={post.data.featured_image}
            href={link("/posts/" + post.id)}
            date={post.data.publishedAt}
            bylines={post.data.bylines}
          />
        ))}
      </div>
    ) : (
      <EmptyUpdates isLoggedIn={isLoggedIn} />
    )}
  </div>

  <SocialFeed />

  <SocialHighlights />
</Base>
