---
import { ArrowRight, CalendarDays, PenLine } from "lucide-react";
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";

let posts: any[] = [];
let cacheHint: unknown;
try {
  const result = await getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: 100,
  });
  posts = result.entries;
  cacheHint = result.cacheHint;
} catch {
  // The public updates page remains useful while the CMS database is initialized.
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<Base
  title="Centre updates"
  description="Daily notes, weekly roundups and announcements from Al-Jannah Centre."
>
  <section class="cms-archive cms-updates-page">
    <header class="cms-archive-heading">
      <p class="kicker">From the Centre</p>
      <h1>Centre updates</h1>
      <p>One dedicated place for daily notes, weekly roundups, programme announcements and stories from Al-Jannah Centre.</p>
      <div class="cms-archive-tools">
        <a class="button button-primary" href="/_emdash/admin"><PenLine size={17} /> Publish an update</a>
        <a class="text-link" href="/posts">View the article archive <ArrowRight size={17} /></a>
      </div>
    </header>

    <section class="cms-publishing-plan" aria-labelledby="publishing-plan-title">
      <div class="cms-publishing-plan-intro">
        <p class="kicker">A simple publishing rhythm</p>
        <h2 id="publishing-plan-title">Keep families close to the Centre.</h2>
        <p>Publish from the secure EmDash admin panel whenever there is a meaningful moment to share. The public page updates automatically after publication.</p>
      </div>
      <div class="cms-publishing-cadence">
        <article>
          <CalendarDays size={19} />
          <div><h3>Daily notes</h3><p>Short classroom moments, reminders, celebrations or thank-yous.</p></div>
        </article>
        <article>
          <CalendarDays size={19} />
          <div><h3>Weekly roundups</h3><p>A fuller recap of progress, activities, events and ways to support.</p></div>
        </article>
      </div>
    </section>

    {posts.length > 0 ? (
      <div class="cms-post-grid cms-post-grid-archive">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            content={post.data.content}
            featuredImage={post.data.featured_image}
            href={"/posts/" + post.id}
            date={post.data.publishedAt}
            bylines={post.data.bylines}
          />
        ))}
      </div>
    ) : (
      <div class="cms-empty-state cms-empty-state-large">
        <div class="cms-empty-mark" aria-hidden="true">AJ</div>
        <div>
          <h2>Your first update can start here</h2>
          <p>Publish a daily note or weekly roundup in EmDash and it will appear on this page automatically.</p>
        </div>
        <a class="button button-primary" href="/_emdash/admin">Open the publishing panel</a>
      </div>
    )}
  </section>
</Base>
