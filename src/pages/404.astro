---
import Base from "../layouts/Base.astro";
import { getLang, localePath, useTranslations } from "../i18n";

const lang = getLang(Astro);
const t = useTranslations(lang);
const link = (path: string) => localePath(lang, path);
---

<Base title={t("notFound.metaTitle")}>
  <section class="container not-found">
    <p class="kicker">404</p>
    <h1>{t("notFound.title")}</h1>
    <p>{t("notFound.text")}</p>
    <div class="hero-actions">
      <a class="button button-primary button-lg" href={link("/")}>{t("notFound.home")}</a>
      <a class="button button-outline button-lg" href={link("/updates")}>{t("notFound.updates")}</a>
    </div>
  </section>
</Base>
