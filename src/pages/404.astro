---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="container not-found">
    <p class="kicker">404</p>
    <h1>That page is not here.</h1>
    <p>It may have moved. Head back to the homepage or see the latest updates from the Centre.</p>
    <div class="hero-actions">
      <a class="button button-primary button-lg" href="/">Back to home</a>
      <a class="button button-outline button-lg" href="/updates">Latest updates</a>
    </div>
  </section>
</Base>
