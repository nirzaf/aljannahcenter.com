---
import { decodeSlug } from "emdash";
import PostView from "../../views/PostView.astro";
import { getLang, localePath } from "../../i18n";
import { getLocalizedEntry } from "../../i18n/content";

const lang = getLang(Astro);
const slug = Astro.params.slug ? decodeSlug(Astro.params.slug) : null;
if (!slug) return Astro.redirect(localePath(lang, "/404"));

// A story without a translation is shown in English.
const { entry: post, cacheHint } = await getLocalizedEntry("posts", slug, lang);
if (!post) return Astro.redirect(localePath(lang, "/404"));
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<PostView post={post} slug={slug} />
