---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import EmptyUpdates from "../../components/EmptyUpdates.astro";
import PostCard from "../../components/PostCard.astro";

let posts: any[] = [];
let cacheHint: unknown;
try {
  const result = await getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: 100,
  });
  posts = result.entries;
  cacheHint = result.cacheHint;
} catch {
  // The archive can show its empty state while the CMS database is initialized.
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
const isLoggedIn = Boolean(Astro.locals.user);
---

<Base
  title="Articles & updates"
  description="Articles, announcements and updates from Al-Jannah Centre."
>
  <header class="page-hero">
    <div class="container">
      <p class="kicker">From the Centre</p>
      <h1>Articles &amp; updates</h1>
      <p>Stories, announcements and celebrations published by the Al-Jannah Centre team.</p>
      {isLoggedIn && (
        <div class="page-hero-actions">
          <a class="button button-primary" href="/_emdash/admin">Publish an update</a>
        </div>
      )}
    </div>
  </header>

  <div class="container page-body">
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            content={post.data.content}
            featuredImage={post.data.featured_image}
            href={"/posts/" + post.id}
            date={post.data.publishedAt}
            bylines={post.data.bylines}
          />
        ))}
      </div>
    ) : (
      <EmptyUpdates isLoggedIn={isLoggedIn} />
    )}
  </div>
</Base>
