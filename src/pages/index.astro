---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import ProgramGrid from "../components/home/ProgramGrid.astro";
import ImpactSection from "../components/home/ImpactSection.astro";
import GalleryPreview from "../components/home/GalleryPreview.astro";
import SupportSection from "../components/home/SupportSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PostCard from "../components/PostCard.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { socialProfiles } from "../data/centre";
import TikTokProfile from "../components/TikTokProfile.astro";

let posts: any[] = [];
let cacheHint: unknown;
try {
  const result = await getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: 3,
  });
  posts = result.entries;
  cacheHint = result.cacheHint;
} catch {
  // The public homepage still renders when a new site's database is awaiting setup.
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<Base title="Al-Jannah Centre" description="Al-Jannah Centre for children with special needs and skills in Kochchikade, Negombo, Sri Lanka.">
  <Hero />

  <ProgramGrid />

  <ImpactSection />

  {posts.length > 0 && (
    <section class="section" id="articles" aria-labelledby="updates-title">
      <div class="container" data-reveal>
        <SectionHeading
          kicker="Stories & updates"
          titleId="updates-title"
          title="Life at the Centre, in stories."
          link={{ href: "/updates", label: "View all stories" }}
        />
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              content={post.data.content}
              featuredImage={post.data.featured_image}
              href={"/posts/" + post.id}
              date={post.data.publishedAt}
              bylines={post.data.bylines}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <GalleryPreview />

  <SupportSection />

  <ContactSection />

  <section class="social-band" aria-labelledby="social-band-title">
    <div class="container social-band-inner">
      <h2 class="social-band-title" id="social-band-title">Stay connected with Al-Jannah</h2>
      <div class="social-band-links">
        {socialProfiles.map((profile) => (
          <a href={profile.href} target="_blank" rel="noopener noreferrer">
            <BrandIcon name={profile.platform} size={17} /> {profile.platform}
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section-tint" aria-label="Al-Jannah Centre on TikTok">
    <div class="container"><TikTokProfile /></div>
  </section>
</Base>
