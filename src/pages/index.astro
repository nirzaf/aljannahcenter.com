---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import ProgramGrid from "../components/home/ProgramGrid.astro";
import ImpactSection from "../components/home/ImpactSection.astro";
import GalleryPreview from "../components/home/GalleryPreview.astro";
import SupportSection from "../components/home/SupportSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PostCard from "../components/PostCard.astro";
import TikTokProfile from "../components/TikTokProfile.astro";
import SocialFeed from "../components/SocialFeed.astro";
import { getLang, localePath, useTranslations } from "../i18n";
import { getLocalizedCollection } from "../i18n/content";

const lang = getLang(Astro);
const t = useTranslations(lang);
const link = (path: string) => localePath(lang, path);

let posts: any[] = [];
let cacheHint: unknown;
try {
  const result = await getLocalizedCollection("posts", { orderBy: { published_at: "desc" }, limit: 3 }, lang);
  posts = result.entries;
  cacheHint = result.cacheHint;
} catch {
  // The public homepage still renders when a new site's database is awaiting setup.
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<Base title={t("site.name")} description={t("site.description")}>
  <Hero />

  <ProgramGrid />

  <ImpactSection />

  {posts.length > 0 && (
    <section class="section" id="articles" aria-labelledby="updates-title">
      <div class="container" data-reveal>
        <SectionHeading
          kicker={t("stories.kicker")}
          titleId="updates-title"
          title={t("stories.title")}
          link={{ href: link("/updates"), label: t("stories.viewAll") }}
        />
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              content={post.data.content}
              featuredImage={post.data.featured_image}
              href={link("/posts/" + post.id)}
              date={post.data.publishedAt}
              bylines={post.data.bylines}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <GalleryPreview />

  <SupportSection />

  <ContactSection />

  <SocialFeed limit={3} link={{ href: link("/updates#social"), label: t("feed.seeMore") }} />

  <section class="section section-tint" id="follow" aria-labelledby="tiktok-title">
    <div class="container" data-reveal><TikTokProfile heading="h2" showProfiles /></div>
  </section>
</Base>
