---
import { getEmDashCollection } from "emdash";
import {
  ArrowRight,
  BookOpen,
  Copy,
  HandHeart,
  HeartHandshake,
  Mail,
  MapPin,
  Palette,
  Phone,
  Sparkles,
  Star,
} from "lucide-react";
import { PhotoGallery } from "../../components/photo-gallery";
import BrandIcon from "../components/BrandIcon.astro";
import SocialHighlights from "../components/SocialHighlights.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { bankAccounts, centre } from "../data/centre";

const focusAreas = [
  {
    icon: BookOpen,
    title: "Education",
    text: "Learning that meets each child where they are, building confidence one step at a time.",
  },
  {
    icon: HeartHandshake,
    title: "Therapy",
    text: "Support that helps children grow in communication, movement and independence.",
  },
  {
    icon: Palette,
    title: "Vocational skills",
    text: "Art, craft and practical skills that turn talents into pride and possibility.",
  },
  {
    icon: Sparkles,
    title: "Faith & values",
    text: "Celebrating every child’s abilities, faith and values together with their families.",
  },
];

const milestones = [
  { value: "2018", label: "Welcoming children and families since the Centre opened" },
  { value: "4", label: "students sat the Grade 5 Scholarship Examination in 2026" },
  { value: "42nd", label: "National Meelad-un-Nabi Cultural Exhibition — Al-Jannah stalls in 2026" },
];

let posts: any[] = [];
let cacheHint: unknown;
try {
  const result = await getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: 3,
  });
  posts = result.entries;
  cacheHint = result.cacheHint;
} catch {
  // The public homepage still renders when a new site's database is awaiting setup.
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<Base title="Al-Jannah Centre" description="Al-Jannah Centre for children with special needs and skills in Kochchikade, Negombo, Sri Lanka.">
  <section class="hero" id="top">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true" /> Since {centre.since} · Kochchikade, Negombo</p>
        <h1>A place where every child can <em>shine.</em></h1>
        <p class="hero-lede">
          Al-Jannah Centre is a caring home for learning and growth for children with
          special needs and skills — and a community for the families, friends and
          supporters who stand beside them.
        </p>
        <div class="hero-actions">
          <a class="button button-gold button-lg" href="#support"><HandHeart size={19} aria-hidden="true" /> Support a child</a>
          <a class="button button-outline button-lg" href="#contact">Contact the Centre <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
        <ul class="hero-tags" aria-label="Areas of focus">
          <li>Education</li>
          <li>Therapy</li>
          <li>Vocational skills</li>
        </ul>
      </div>

      <div class="hero-visual">
        <figure class="hero-photo hero-photo-main">
          <img src="/hero/welcome.webp" alt="The Welcome Al-Jannah Centre arch at the Centre entrance" width="960" height="1200" fetchpriority="high" />
        </figure>
        <figure class="hero-photo hero-photo-top">
          <img src="/hero/creativity.webp" alt="A child and teacher working on an art project at the Centre" width="800" height="800" />
        </figure>
        <figure class="hero-photo hero-photo-bottom">
          <img src="/hero/community.webp" alt="Children, staff and guests gathered for a group photo at the Centre" width="960" height="720" />
        </figure>
        <div class="hero-badge">
          <Star size={18} aria-hidden="true" />
          <span><strong>8 years</strong> of care &amp; community</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="focus-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="kicker">What we do</p>
          <h2 id="focus-title">Celebrating abilities, talents, faiths and values.</h2>
        </div>
        <p>
          The Centre’s work spans education, therapy and vocational training for children with
          special needs. For programme, admission and visit enquiries, please speak with the Centre directly.
        </p>
      </div>
      <div class="focus-grid">
        {focusAreas.map(({ icon: Icon, title, text }) => (
          <article class="focus-card">
            <span class="focus-icon"><Icon size={22} aria-hidden="true" /></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-title">
    <div class="container story-inner">
      <figure class="story-photo">
        <img src="/hero/artists.webp" alt="Children painting together around a table at Al-Jannah Centre" width="800" height="800" loading="lazy" decoding="async" />
      </figure>
      <div class="story-copy">
        <p class="kicker">Proud moments</p>
        <h2 id="story-title">Small steps. Big achievements.</h2>
        <p>
          From classroom art to national exhibitions and exam halls, every milestone at the Centre is
          shared by the children, their teachers and their families.
        </p>
        <dl class="milestones">
          {milestones.map((item) => (
            <div>
              <dt>{item.value}</dt>
              <dd>{item.label}</dd>
            </div>
          ))}
        </dl>
        <a class="text-link" href="/pages/about">Learn about the Centre <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" id="articles" aria-labelledby="updates-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="kicker">From the Centre</p>
            <h2 id="updates-title">Latest updates</h2>
          </div>
          <a class="text-link" href="/updates">See all updates <ArrowRight size={17} aria-hidden="true" /></a>
        </div>
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              content={post.data.content}
              featuredImage={post.data.featured_image}
              href={"/posts/" + post.id}
              date={post.data.publishedAt}
              bylines={post.data.bylines}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <PhotoGallery client:visible />

  <SocialHighlights />

  <section class="support" id="support" aria-labelledby="support-title">
    <div class="container support-inner">
      <div class="support-copy">
        <p class="kicker kicker-light">Support the Centre</p>
        <h2 id="support-title">Your support helps make room for possibility.</h2>
        <p>
          Every contribution helps provide care, learning materials and special days for the children.
          Please contact the Centre before giving so they can confirm the details with you.
        </p>
        <ol class="give-steps">
          <li><span>1</span> Choose one of the Centre’s bank accounts below.</li>
          <li><span>2</span> Make your transfer to “Al-Jannah Centre”.</li>
          <li><span>3</span> Let the Centre know on WhatsApp so they can thank you.</li>
        </ol>
        <div class="support-actions">
          <a class="button button-gold button-lg" href={centre.whatsapp.donationHref} target="_blank" rel="noopener noreferrer">
            <BrandIcon name="whatsapp" /> Confirm on WhatsApp
          </a>
          <a class="button button-ghost-light" href="/support-poster.webp" target="_blank" rel="noopener">View support poster</a>
        </div>
      </div>

      <div class="accounts">
        {bankAccounts.map((item) => (
          <article class="account-card">
            <header class="account-head">
              <span class="account-mark" aria-hidden="true">AJ</span>
              <div><small>Bank</small><strong>{item.bank}</strong></div>
            </header>
            <div class="account-number">
              <div>
                <small>Account number</small>
                <strong>{item.account}</strong>
              </div>
              <button class="copy-button" type="button" data-copy={item.account.replace(/-/g, "")} aria-label={"Copy " + item.bank + " account number"}>
                <Copy size={16} aria-hidden="true" /> <span data-copy-label>Copy</span>
              </button>
            </div>
            <dl>
              <div><dt>Account name</dt><dd>Al-Jannah Centre</dd></div>
              <div><dt>Branch</dt><dd>{item.branch}</dd></div>
              <div><dt>SWIFT</dt><dd>{item.swift}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div class="contact-copy">
        <p class="kicker">Get in touch</p>
        <h2 id="contact-title">We’re here to connect.</h2>
        <p>Reach out for enquiries, admissions, visits and support. WhatsApp is often the quickest way to reach the team.</p>
        <div class="contact-list">
          <a href={centre.phone.href}><span class="contact-icon"><Phone size={20} aria-hidden="true" /></span><span><small>Call</small><strong>{centre.phone.label}</strong></span></a>
          <a href={centre.whatsapp.href} target="_blank" rel="noopener noreferrer"><span class="contact-icon contact-icon-wa"><BrandIcon name="whatsapp" /></span><span><small>WhatsApp</small><strong>{centre.whatsapp.label}</strong></span></a>
          <a href={centre.email.href}><span class="contact-icon"><Mail size={20} aria-hidden="true" /></span><span><small>Email</small><strong class="break">{centre.email.label}</strong></span></a>
          <a href={centre.address.mapHref} target="_blank" rel="noopener noreferrer"><span class="contact-icon"><MapPin size={20} aria-hidden="true" /></span><span><small>Visit</small><strong>{centre.address.lines.join(", ")}</strong></span></a>
        </div>
      </div>
      <div class="map-card">
        <iframe
          title="Map showing Al-Jannah Centre, 20/A Negombo Road, Kochchikade"
          src={centre.address.embedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Base>
